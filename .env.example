DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=

# Optional permitted JSON seat feed. Exact seat-number monitoring only works
# when a legitimate seat feed is provided here.
CGV_FEED_URL=
POLL_SECONDS=60
MAX_BACKOFF_SECONDS=900

# Direct page watcher is optional. Leave blank when CGV returns HTTP 403.
CGV_PUBLIC_PAGE_URL=
CGV_PUBLIC_PAGE_KEYWORDS=IMAX,아이맥스
CGV_PUBLIC_PAGE_POLL_SECONDS=180
CGV_PUBLIC_PAGE_MAX_BACKOFF_SECONDS=1800

# Chrome local bridge. Receives only visible page observations on localhost.
BROWSER_BRIDGE_HOST=127.0.0.1
BROWSER_BRIDGE_PORT=8765
BROWSER_REQUIRED_KEYWORDS=오디세이,IMAX
